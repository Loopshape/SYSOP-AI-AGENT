#!/usr/bin/env bash
# AI Autonomic Synthesis Platform (Streaming Mandatory Edition)
# ~/bin/ai

set -euo pipefail
IFS=$'\n\t'

# --- PATHS ---
AI_HOME="${AI_HOME:-$HOME/.ai_agent}"
PROJECTS_DIR="${PROJECTS_DIR:-$HOME/.ai_project}"
LOG_DIR="$AI_HOME/logs"
TMP_DIR="$AI_HOME/tmp"
SWAP_DIR="$AI_HOME/swap"
CORE_DB="$AI_HOME/agent_core.db"
TASK_DB="$HOME/.ai_task_manager.db"
HMAC_SECRET_KEY="$AI_HOME/secret.key"

# --- MODELS ---
MESSENGER_MODEL="core"
PLANNER_MODELS=("loop" "2244-1")
EXECUTOR_MODEL="2244-1"
TRADING_MODEL="loop"
OLLAMA_BIN="$(command -v ollama || echo 'ollama')"

MAX_AGENT_LOOPS=7
MAX_RAM_BYTES=2097152

# --- COLORS ---
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; BLUE='\033[0;34m'
NC='\033[0m'

# --- HELPERS ---
sql_escape(){ echo "$1" | sed "s/'/''/g"; }
sqlite_escape(){ echo "$1" | sed "s/'/''/g"; }
sha256_file(){ sha256sum "$1" | awk '{print $1}'; }
hash_string(){ echo -n "$1" | sha256sum | cut -d' ' -f1; }

# --- LOGGING ---
log_msg(){ echo -e "$1[$2][$(date '+%T')] $3${NC}" >&2; }
log_info(){ log_msg "$BLUE" "INFO" "$*"; }
log_warn(){ log_msg "$YELLOW" "WARN" "$*"; }
log_success(){ log_msg "$GREEN" "SUCCESS" "$*"; }

# --- DB INIT ---
init_db(){
    if [[ ! -f "$TASK_DB" ]]; then
        sqlite3 "$TASK_DB" <<'SQL'
CREATE TABLE projects (hash TEXT PRIMARY KEY, path TEXT, ts DATETIME DEFAULT CURRENT_TIMESTAMP);
CREATE TABLE file_hashes (project_hash TEXT, file_path TEXT, file_hash TEXT, rehashed INTEGER DEFAULT 0,
    PRIMARY KEY(project_hash,file_path));
CREATE TABLE events (id INTEGER PRIMARY KEY AUTOINCREMENT, ts DATETIME DEFAULT CURRENT_TIMESTAMP, type TEXT, data TEXT);
SQL
        log_success "Initialized Task DB at $TASK_DB"
    fi
}

init_core_db() {
    sqlite3 "$CORE_DB" "CREATE TABLE IF NOT EXISTS _master_schema (table_name TEXT PRIMARY KEY, description TEXT, schema_sql TEXT);"
    sqlite3 "$CORE_DB" "CREATE TABLE IF NOT EXISTS memories (id INTEGER PRIMARY KEY, prompt_hash TEXT, prompt TEXT, response_ref TEXT);"
    sqlite3 "$CORE_DB" "CREATE TABLE IF NOT EXISTS tool_logs (id INTEGER PRIMARY KEY, task_id TEXT, tool_name TEXT, args TEXT, result TEXT);"
}

# --- STREAMING WORKER (mandatory) ---
run_worker_streaming() {
    local model="$1" system_prompt="$2" prompt="$3"
    local full_response=""
    local payload

    payload=$(jq -nc --arg m "$model" --arg s "$system_prompt" --arg p "$prompt" \
        '{model:$m,system:$s,prompt:$p,stream:true}')

    while IFS= read -r line; do
        if jq -e . >/dev/null 2>&1 <<<"$line"; then
            local token
            token=$(echo "$line" | jq -r '.response // empty')
            if [[ -n "$token" ]]; then
                printf "%s" "$token" >&2
                full_response+="$token"
            fi
        fi
    done < <(curl -s --max-time 300 -X POST http://localhost:11434/api/generate -d "$payload")

    printf "\n" >&2
    echo "$full_response"
}

run_worker_fast() {
    log_warn "⚠️ Non-streaming mode is disabled. Using streaming instead."
    run_worker_streaming "$@"
}

# --- HUMAN INTERACTION ---
confirm_action() {
    local c=""
    read -p "Approve? [y/N] " -n 1 -r c || true
    echo
    [[ "${c:-N}" =~ ^[Yy]$ ]]
}

tool_ask_human() {
    local proj_dir="$1"; shift
    echo -e "\n🤔 ${YELLOW}AI requests your input:${NC} ${BLUE}$*${NC}"
    read -p "Your Response: " -r user_response
    echo "Human feedback: '$user_response'"
}

# --- TOOLS ---
ingest_repo(){
    local repo="$1"
    [[ -d "$repo" ]] || { echo "Repo not found: $repo"; return 1; }
    local hash
    hash=$(echo -n "$repo" | sha256sum | awk '{print $1}')
    sqlite3 "$TASK_DB" "INSERT OR IGNORE INTO projects(hash,path) VALUES('$(sql_escape "$hash")','$(sql_escape "$repo")');"

    find "$repo" -type f | while read -r f; do
        local fh=$(sha256_file "$f")
        sqlite3 "$TASK_DB" "INSERT OR REPLACE INTO file_hashes(project_hash,file_path,file_hash) VALUES('$(sql_escape "$hash")','$(sql_escape "$f")','$fh');"
    done
    log_success "Repo ingested: $repo -> $hash"
    echo "$hash"
}

rehash_repo_files(){
    local repo_hash="$1"; shift
    local base=$(sqlite3 "$TASK_DB" "SELECT path FROM projects WHERE hash='$(sql_escape "$repo_hash")' LIMIT 1;")
    [[ -z "$base" ]] && { echo "No project path for $repo_hash"; return 1; }

    find "$base" -type f | while read -r f; do
        local newh=$(sha256_file "$f")
        local oldh=$(sqlite3 "$TASK_DB" "SELECT file_hash FROM file_hashes WHERE project_hash='$(sql_escape "$repo_hash")' AND file_path='$(sql_escape "$f")';")
        if [[ "$newh" != "$oldh" ]]; then
            sqlite3 "$TASK_DB" "INSERT OR REPLACE INTO file_hashes(project_hash,file_path,file_hash,rehashed) VALUES('$(sql_escape "$repo_hash")','$(sql_escape "$f")','$newh',1);"
        fi
    done
    log_success "Rehash completed for $repo_hash"
}

tool_trade(){
    local asset="${1:-BTC/USD}"
    log_info "Analyzing market for $asset..."
    run_worker_streaming "$TRADING_MODEL" "You are a professional crypto trading analyst." \
        "Provide detailed market analysis for $asset with RSI, MACD, support/resistance, and sentiment."
}

# --- AGI WORKFLOW ---
run_agi_workflow(){
    local user_prompt="$*"
    local task_id
    task_id=$(hash_string "$user_prompt$(date +%s%N)" | cut -c1-16)
    local project_dir="$PROJECTS_DIR/task-$task_id"
    mkdir -p "$project_dir"
    log_success "Project workspace: $project_dir (Task ID: $task_id)"

    local conversation_history="User Request: $user_prompt"

    for ((i=1; i<=MAX_AGENT_LOOPS; i++)); do
        log_info "AGI Loop $i/$MAX_AGENT_LOOPS"

        local messenger_output
        messenger_output=$(run_worker_streaming "$MESSENGER_MODEL" "Analyze the current state." "$conversation_history")

        local executor_context="You are the Executor. Choose best tool or give final answer.
Format: [TOOL] tool_name <args> OR [FINAL_ANSWER] text

--- Context ---
$messenger_output"

        local final_plan
        final_plan=$(run_worker_streaming "$EXECUTOR_MODEL" "Executor" "$executor_context")

        if [[ "$final_plan" == *"[FINAL_ANSWER]"* ]]; then
            echo -e "\n${GREEN}--- Final Result ---${NC}"
            echo "$final_plan" | sed 's/.*\[FINAL_ANSWER\] //'
            return
        fi
    done

    echo "Workflow ended without final answer."
}

# --- MAIN ---
show_help(){
    cat <<EOF
Usage: ai <command> [options]

AI Core:
  <prompt>         Run AGI workflow with streaming
Task Management:
  ingest <path>    Ingest project for tracking
  rehash <hash>    Rehash project files
Trading:
  trade [asset]    Market analysis (default BTC/USD)
System:
  status           Show system status
  heal             Clear temporary files
EOF
}

main(){
    init_db
    init_core_db
    local cmd="${1:-}"
    case "$cmd" in
        -h|--help|help) show_help ;;
        ingest) shift; ingest_repo "$@" ;;
        rehash) shift; rehash_repo_files "$@" ;;
        trade) shift; tool_trade "$@" ;;
        heal) rm -rf "$TMP_DIR"/* 2>/dev/null; log_success "Temporary files cleared" ;;
        status)
            echo "AI_HOME: $AI_HOME"
            echo "Projects: $PROJECTS_DIR"
            echo "Task DB: $TASK_DB"
            echo "Core DB: $CORE_DB"
            curl -s http://localhost:11434/api/tags >/dev/null && echo "Ollama: ✅ Running" || echo "Ollama: ❌ Stopped"
            ;;
        "") log_warn "No command provided"; show_help ;;
        *) run_agi_workflow "$@" ;;
    esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
